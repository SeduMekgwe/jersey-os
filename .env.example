# Local development only. Copy to .env and replace every change-me value.
JERSEYOS_SQL_PASSWORD=change-me-with-a-long-random-password
JERSEYOS_DB=JerseyOs
JERSEYOS_REDIS=redis:6379,abortConnect=false
JERSEYOS_JWT_ISSUER=https://localhost:7080
JERSEYOS_JWT_AUDIENCE=jersey-os-web
JERSEYOS_JWT_SIGNING_KEY=change-me-at-least-64-random-characters-long-for-hmac
JERSEYOS_DEFAULT_ORGANIZATION_ID=0190f2f2-67a1-7b11-a9e8-5f4921816f53
JERSEYOS_BOOTSTRAP_ORGANIZATION=Jersey No.10 Collective
JERSEYOS_BOOTSTRAP_ORGANIZATION_SLUG=jersey-no10-collective
JERSEYOS_BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
JERSEYOS_BOOTSTRAP_ADMIN_PASSWORD=change-me-with-a-unique-password
JERSEYOS_CORS_ORIGINS=http://localhost:4173,http://localhost:5173
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
VITE_API_BASE_URL=/api/v1
